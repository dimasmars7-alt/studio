DirectoryIndex index.html
Options -Indexes

<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType text/css .css
  AddType application/manifest+json .webmanifest
  AddCharset UTF-8 .html .css .js .json
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <Files "sw.js">
    Header set Cache-Control "no-store, max-age=0"
  </Files>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json
</IfModule>

# Enable HTTPS redirection in your hosting panel AFTER installing SSL.
# Hash routing is used: SPA rewrite rules are not required.

